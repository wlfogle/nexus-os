{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Librarian",
  "version": "0.1.0",
  "identifier": "dev.wlfogle.librarian",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Librarian",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Repo-aware ecosystem librarian",
    "longDescription": "Indexes everything you own, reads and interprets each file with a local LLM, scores it against your git repos, and files it where it belongs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
