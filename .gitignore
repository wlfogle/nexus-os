# Build artifacts
build/
obj/
bin/
*.o
*.so
*.a
*.elf
*.bin
*.img
*.iso

# Kernel images (but not kernel source)
kernel.bin
boot.img
nexus-os.iso

# Generated files
*.d
*.dep
*.map

# Qt build files
moc_*
qrc_*
ui_*
Makefile.qt
*.pro.user
debug/
release/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
# Kate writes `.<name>.kate-swp`, which `*.swp` does not match (the suffix is
# `-swp`, not `.swp`). One of these was committed by accident on 2026-10-14.
*.kate-swp

# OS-specific
.DS_Store
Thumbs.db

# Debug and log files
*.log
wget-log*
*.dump
gdb.txt
logs/

# Package caches
*.deb
*.rpm
*.pkg.tar.zst
*.AppImage
*.snap
*.whl

# Temporary files
tmp/
temp/
.cache/

# Configuration files with sensitive info
secrets.env
*.key
*.pem

# Build system generated files
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Cross-compiler toolchain
toolchain/

# QEMU files
*.qcow2
*.vdi
*.vmdk

# Documentation build
docs/build/
docs/_build/

# Backup files
*.bak
*.backup

# Package build artifacts (monorepo)
packages/*/node_modules/
packages/*/target/
packages/*/dist/
packages/*/build/
packages/*/.gradle/
packages/*/legacy/
packages/*/.next/
packages/*/.vite/
packages/*/out/
packages/*/*.apk

# App build artifacts (monorepo)
userspace/apps/*/node_modules/
userspace/apps/*/dist/
userspace/apps/*/target/
userspace/apps/*/build/
userspace/apps/*/.next/
userspace/apps/*/.vite/
userspace/apps/*/out/

# The single-level globs above only reach one directory deep, so a package with
# its own sub-project (e.g. `packages/foo/frontend/node_modules/`) slipped past
# them -- 2019 such files were committed by accident on 2026-10-14. These depth
# independent rules catch build output wherever it is nested.
node_modules/
**/node_modules/
**/dist/
**/.vite/
**/.next/

# Test artifacts
test-results/
test_results/
coverage/
test-install/
test-root/
